# Dub self-hosted stack configuration
# Copy to .env.selfhost, adjust, then:
#   docker compose --env-file .env.selfhost up -d --build

# ------------------------------------------------------------- secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=AtpMpwA1geu6KRLh4jwolOWT845uFdmzZ2CnLRdcU5E=
# AES-256-GCM key for encrypting sensitive DB columns (base64, 32 bytes)
ENCRYPTION_KEY=ZHSlHujIN5X9b+/qtdSzgeteVfD6xYrZhseyry3xo8U=
# Shared secret the cron scheduler sends to /api/cron/* endpoints
CRON_SECRET=5020404ba5675bf523947c24eff4950f76b388aab8cc98eb
# Shared tokens between the web app and the local service emulators
REDIS_REST_TOKEN=selfhost-redis-token
QSTASH_TOKEN=selfhost-qstash-token
QSTASH_CURRENT_SIGNING_KEY=selfhost-current-signing-key
QSTASH_NEXT_SIGNING_KEY=selfhost-next-signing-key
TINYBIRD_API_KEY=selfhost-tinybird-token

# ------------------------------------------------------------- database
POSTGRES_USER=dub
POSTGRES_PASSWORD=dub
POSTGRES_DB=dub
# ClickHouse credentials (for the analytics layer)
CLICKHOUSE_USER=dub
CLICKHOUSE_PASSWORD=dub

# ------------------------------------------------------------- endpoints
# Public URL of the web app (what users type in the browser)
NEXTAUTH_URL=http://localhost:8888
WEB_PORT=8888
# Mailpit web UI port (SMTP is internal-only)
MAILPIT_UI_PORT=8025
# Local object storage (RustFS) ports (API + console).
# To use an EXTERNAL S3 instead: set STORAGE_INTERNAL_ENDPOINT /
# STORAGE_BASE_URL / STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY
# below to your external endpoint, and stop the rustfs service.
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_ACCESS_KEY_ID=dub
STORAGE_SECRET_ACCESS_KEY=dubsecret
#STORAGE_INTERNAL_ENDPOINT=http://your-s3:9000
#STORAGE_BASE_URL=http://your-s3-public-url
#STORAGE_PUBLIC_BUCKET=dub-public
#STORAGE_PRIVATE_BUCKET=dub-private

# ------------------------------------------------------------- domains
# Comma-separated shared short-link domains served by this instance.
# *.localhost resolves to 127.0.0.1 in every browser, so dub.localhost
# works out of the box for local testing. For production, use real
# domains whose DNS points at this server, e.g. "go.example.com".
SELFHOST_DOMAINS=dub.localhost
# Extra hostnames the app treats as itself (defaults to the in-network
# service name; rarely needs changing)
SELFHOST_APP_HOSTNAMES=web:3000

# ------------------------------------------------------------- optional
# npm mirror for faster builds in some regions (e.g. https://registry.npmmirror.com)
NPM_REGISTRY=
# Extra Vercel-style cron overrides ("*/5 * * * *|/api/cron/..." lines)
CRON_JOBS=
# Analytics (optional): your Plausible site script URL, served via the
# local /_proxy/plausible/* proxy. Leave empty to disable entirely.
#NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/pa-XXXXX.js
